# Deny files by default; traverse directories to find explicitly allowed files.
# Add narrow exceptions below when introducing new project files.
*
!*/

# Repository metadata and documentation.
!/.gitignore
!/.dockerignore
!/.gitattributes
!/README.md
!/README.en.md
!/docs/images/console-executions.png
!/docs/images/console-new-execution.png
!/docs/images/console-batch.png
!/docs/images/console-workflow.png
!/docs/images/console-comparison.png
!/docs/images/console-kafka.png
!/docs/images/console-mobile.png
!/docs/blog/02-kafka-llm-jev.md
!/docs/blog/03-draft-review-revision.md
!/docs/blog/04-review-effect-comparison.md
!/docs/blog/05-codex-cli.md
!/docs/blog/06-codex-review-comparison.md
!/docs/blog/images/03-workflow-comparison.png
!/docs/blog/images/05-codex-comparison.png
!/docs/blog/images/05-codex-workflow.png
!/docs/blog/images/06-codex-error-review.png
!/docs/blog/images/06-codex-correct-review.png
!/docs/experiments/2026-10-07-codex-review.json

# Build and container definitions.
!/build.gradle
!/settings.gradle
!/gradlew
!/gradlew.bat
!/Dockerfile
!/docker-compose.yml
!/docker-compose.gpu.yml
!/docker-compose.ollama.yml
!/docker-compose.codex.yml
!/docker/coral/Dockerfile
!/docker/coral/.dockerignore
!/docker/coral/entrypoint.sh
!/docker/coral/healthcheck.sh
!/docker/coral/capture.sh
!/docker/coral/coral-agent.toml
!/scripts/smoke.ps1
!/scripts/recovery.ps1
!/scripts/workflow.ps1
!/scripts/compare.ps1
!/scripts/codex_bridge.py
!/scripts/test_codex_bridge.py
!/scripts/start-codex.ps1
!/.github/workflows/ci.yml
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# Java sources and the shared, secret-free application configuration.
!/src/main/java/**/*.java
!/src/test/java/**/*.java
!/src/main/resources/application.yml
!/src/main/resources/schema.sql
!/src/main/resources/static/index.html
!/src/main/resources/static/console.css
!/src/main/resources/static/workbench.js
!/src/main/resources/static/kafka-topology.js
!/src/main/resources/static/kafka-topology.css

# Keep private directories excluded even inside an allowed source tree.
.git/
.gradle/
build/
out/
target/
bin/
.idea/
.vscode/
.agents/
.codex/
node_modules/
.venv/
__pycache__/
.ssh/
.aws/
.azure/
.config/
.kube/
.gnupg/
secrets/
credentials/
certificates/
logs/
models/
data/
backups/

# Defense in depth: these stay excluded if the allowlist is later expanded.
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
credentials.json
credentials.yml
credentials.yaml
service-account*.json
application-local.*
application-secret*.*
gradle.properties
*.log
*.hprof
*.heapdump
hs_err_pid*
*.sql
*.dump
*.sqlite*
*.db
*.gguf
*.safetensors
*.onnx
*.zip
*.tar
*.gz
*.bak
*.tmp
*.swp
*~

# The shared schema is source code, not a database export.
!/src/main/resources/schema.sql
