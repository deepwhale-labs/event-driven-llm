# Deny files by default; traverse directories to find explicitly allowed files.
# Add narrow exceptions below when introducing new project files.
*
!*/

# Repository metadata and documentation.
!/.gitignore
!/.dockerignore
!/.gitattributes
!/README.md

# Build and container definitions.
!/build.gradle
!/settings.gradle
!/gradlew
!/gradlew.bat
!/Dockerfile
!/docker-compose.yml
!/docker-compose.gpu.yml
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# Java sources and the shared, secret-free application configuration.
!/src/main/java/**/*.java
!/src/test/java/**/*.java
!/src/main/resources/application.yml

# Keep private directories excluded even inside an allowed source tree.
.git/
.gradle/
build/
out/
target/
bin/
.idea/
.vscode/
.agents/
.codex/
node_modules/
.venv/
__pycache__/
.ssh/
.aws/
.azure/
.config/
.kube/
.gnupg/
secrets/
credentials/
certificates/
logs/
models/
data/
backups/

# Defense in depth: these stay excluded if the allowlist is later expanded.
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
credentials.json
credentials.yml
credentials.yaml
service-account*.json
application-local.*
application-secret*.*
gradle.properties
*.log
*.hprof
*.heapdump
hs_err_pid*
*.sql
*.dump
*.sqlite*
*.db
*.gguf
*.safetensors
*.onnx
*.zip
*.tar
*.gz
*.bak
*.tmp
*.swp
*~
